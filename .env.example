# Required in production. Use a long random secret (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required in production. Development defaults to localhost MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=modern-poultry

# Comma-separated frontend origins in production.
CORS_ORIGINS=http://localhost:5173

PORT=5000
NODE_ENV=development
